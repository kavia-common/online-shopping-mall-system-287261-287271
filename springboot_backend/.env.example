# Backend URL Configuration
BACKEND_URL=https://your-backend-url.com
FRONTEND_URL=https://your-frontend-url.com
SITE_URL=https://your-frontend-url.com

# CORS Configuration
ALLOWED_ORIGINS=https://your-frontend-url.com,http://localhost:3000
ALLOWED_HEADERS=Content-Type,Authorization,X-Requested-With
ALLOWED_METHODS=GET,POST,PUT,DELETE,PATCH,OPTIONS
CORS_MAX_AGE=3600

# Server Configuration
HOST=0.0.0.0
PORT=3001
TRUST_PROXY=true

# Database Configuration - MySQL
# Update these values based on your MySQL setup
SPRING_DATASOURCE_URL=jdbc:mysql://localhost:3306/shopping_mall?useSSL=false&serverTimezone=UTC&allowPublicKeyRetrieval=true
SPRING_DATASOURCE_USERNAME=root
SPRING_DATASOURCE_PASSWORD=

# Redis Configuration
# Update these if Redis is running on a different host/port
SPRING_DATA_REDIS_HOST=localhost
SPRING_DATA_REDIS_PORT=6379

# JWT Configuration
# IMPORTANT: Change this secret key in production! Use a strong, random string.
JWT_SECRET=mySecureJwtSecretKeyForProductionUseChangeThis1234567890AbCdEfGhIjKlMnOp
JWT_EXPIRATION=86400000

# Application Configuration
SPRING_PROFILES_ACTIVE=dev
NODE_ENV=development
REQUEST_TIMEOUT_MS=30000
RATE_LIMIT_WINDOW_S=60
RATE_LIMIT_MAX=100
